{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tars.local/evaluation/gold-v1",
  "title": "TARS UPSC News gold record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "observationIds",
    "metadata",
    "sampling",
    "review",
    "gold",
    "partition"
  ],
  "properties": {
    "version": {
      "const": "tars-news-gold/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "observationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "sampling": {
      "$ref": "#/$defs/sampling"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "annotations",
        "adjudication"
      ],
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "in_review",
            "disputed",
            "adjudicated",
            "unresolvable"
          ]
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewerId",
              "reviewedAt",
              "rubricVersion",
              "labels",
              "evidence"
            ],
            "properties": {
              "reviewerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "reviewedAt": {
                "type": "string",
                "format": "utc-instant"
              },
              "rubricVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "labels": {
                "$ref": "#/$defs/labels"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/span"
                },
                "minItems": 1,
                "maxItems": 30,
                "uniqueItems": true
              }
            }
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "adjudication": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "adjudicatorId",
                "reviewedAt",
                "rationale",
                "resolutionVersion",
                "labels"
              ],
              "properties": {
                "adjudicatorId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "reviewedAt": {
                  "type": "string",
                  "format": "utc-instant"
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "resolutionVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "labels": {
                  "$ref": "#/$defs/labels"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "gold": {
      "$ref": "#/$defs/labels"
    },
    "partition": {
      "enum": [
        "development",
        "validation",
        "holdout_unseen",
        "holdout_forward",
        "legacy_regression",
        "synthetic_adversarial"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "adjudicated"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "annotations": {
                "minItems": 2
              },
              "adjudication": {
                "type": "object"
              }
            }
          },
          "gold": {
            "properties": {
              "value": {
                "enum": [
                  "must_read",
                  "useful",
                  "reject"
                ]
              },
              "contentType": {
                "type": "string"
              },
              "partyPoliticsPrimary": {
                "type": "boolean"
              },
              "partyMention": {
                "type": "boolean"
              },
              "scope": {
                "type": "string"
              },
              "scopeReason": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "metadataSufficiency": {
                "type": "object"
              },
              "reviewBasis": {
                "const": "feed_metadata"
              },
              "novelty": {
                "type": "object"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "review": {
            "properties": {
              "adjudication": {
                "type": "null"
              }
            }
          },
          "gold": {
            "const": {
              "value": null,
              "primarySubject": null,
              "secondarySubjects": [],
              "contentType": null,
              "partyPoliticsPrimary": null,
              "partyMention": null,
              "scope": null,
              "scopeReason": null,
              "storyId": null,
              "themeId": null,
              "angleId": null,
              "novelty": null,
              "materialDelta": null,
              "rejectReasons": [],
              "rationale": null,
              "metadataSufficiency": null,
              "reviewBasis": null
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "in_review"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "annotations": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "enum": [
                  "disputed",
                  "unresolvable"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "annotations": {
                "minItems": 2
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title",
        "description",
        "publisher",
        "memberships",
        "categories",
        "bylines",
        "publishedAt",
        "updatedAt"
      ],
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2048,
          "format": "article-url"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "memberships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "feedUrl",
              "section"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "feedUrl": {
                "type": "string",
                "maxLength": 2048,
                "format": "article-url"
              },
              "section": {
                "type": "string",
                "minLength": 0,
                "maxLength": 120
              }
            }
          },
          "minItems": 1,
          "maxItems": 99,
          "uniqueItems": true
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 0,
          "maxItems": 30,
          "uniqueItems": true
        },
        "bylines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "provenance"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "provenance": {
                "enum": [
                  "rss:dc:creator",
                  "rss:author",
                  "atom:author"
                ]
              }
            }
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "utc-instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "utc-instant"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "field",
        "start",
        "end"
      ],
      "properties": {
        "observationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "field": {
          "enum": [
            "title",
            "description",
            "categories",
            "bylines"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "primarySubject",
        "secondarySubjects",
        "contentType",
        "partyPoliticsPrimary",
        "partyMention",
        "scope",
        "scopeReason",
        "storyId",
        "themeId",
        "angleId",
        "novelty",
        "materialDelta",
        "rejectReasons",
        "rationale",
        "metadataSufficiency",
        "reviewBasis"
      ],
      "properties": {
        "value": {
          "enum": [
            "must_read",
            "useful",
            "reject",
            null
          ]
        },
        "primarySubject": {
          "enum": [
            "Polity",
            "Governance",
            "Economy",
            "International relations",
            "Security",
            "Sci-Tech",
            "Environment",
            "Geography",
            "History & Culture",
            "not_applicable",
            null
          ]
        },
        "secondarySubjects": {
          "type": "array",
          "items": {
            "enum": [
              "Polity",
              "Governance",
              "Economy",
              "International relations",
              "Security",
              "Sci-Tech",
              "Environment",
              "Geography",
              "History & Culture"
            ]
          },
          "minItems": 0,
          "maxItems": 9,
          "uniqueItems": true
        },
        "contentType": {
          "enum": [
            "news_report",
            "explainer",
            "editorial",
            "column",
            "analysis",
            "digest",
            "interview",
            "official_release",
            "other",
            "unknown",
            null
          ]
        },
        "partyPoliticsPrimary": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "partyMention": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "enum": [
            "india_domestic",
            "india_impact",
            "global_knowledge",
            "global_systemic",
            "foreign_domestic_no_impact",
            "unknown",
            null
          ]
        },
        "scopeReason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            {
              "type": "null"
            }
          ]
        },
        "storyId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "themeId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "angleId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "novelty": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "relativeTo",
                "cutoff"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "new_development",
                    "distinct_analysis",
                    "repeat",
                    "uncertain",
                    "not_applicable"
                  ]
                },
                "relativeTo": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "minItems": 0,
                  "maxItems": 10000,
                  "uniqueItems": true
                },
                "cutoff": {
                  "type": "string",
                  "format": "utc-instant"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "materialDelta": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "description",
                "evidence"
              ],
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/span"
                  },
                  "minItems": 1,
                  "maxItems": 30,
                  "uniqueItems": true
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "rejectReasons": {
          "type": "array",
          "items": {
            "enum": [
              "party_primary",
              "foreign_domestic_no_impact",
              "routine_local",
              "promotion",
              "entertainment_primary",
              "no_substantive_value",
              "out_of_scope",
              "other"
            ]
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "metadataSufficiency": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "level",
                "missingFields"
              ],
              "properties": {
                "level": {
                  "enum": [
                    "sufficient",
                    "limited",
                    "insufficient"
                  ]
                },
                "missingFields": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "title",
                      "description",
                      "bylines",
                      "categories",
                      "publication_time",
                      "scope",
                      "development",
                      "angle"
                    ]
                  },
                  "minItems": 0,
                  "maxItems": 8,
                  "uniqueItems": true
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewBasis": {
          "enum": [
            "feed_metadata",
            null
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "enum": [
                  "must_read",
                  "useful"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "rejectReasons": {
                "maxItems": 0
              },
              "partyPoliticsPrimary": {
                "const": false
              },
              "scope": {
                "enum": [
                  "india_domestic",
                  "india_impact",
                  "global_knowledge",
                  "global_systemic",
                  "unknown"
                ]
              },
              "primarySubject": {
                "not": {
                  "const": "not_applicable"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value": {
                "const": "reject"
              }
            }
          },
          "then": {
            "properties": {
              "rejectReasons": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "partyPoliticsPrimary": {
                "const": true
              },
              "value": {
                "enum": [
                  "must_read",
                  "useful",
                  "reject"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": "reject"
              },
              "rejectReasons": {
                "contains": {
                  "const": "party_primary"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "foreign_domestic_no_impact"
              },
              "value": {
                "enum": [
                  "must_read",
                  "useful",
                  "reject"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": "reject"
              },
              "rejectReasons": {
                "contains": {
                  "const": "foreign_domestic_no_impact"
                }
              }
            }
          }
        }
      ]
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel",
        "stratum",
        "seed",
        "inclusionProbability",
        "populationDenominator",
        "window",
        "manifestHash",
        "synthetic"
      ],
      "properties": {
        "panel": {
          "enum": [
            "representative",
            "coverage",
            "stress"
          ]
        },
        "stratum": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "inclusionProbability": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "populationDenominator": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "utc-instant"
            },
            "end": {
              "type": "string",
              "format": "utc-instant"
            }
          }
        },
        "manifestHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "panel": {
                "const": "representative"
              }
            }
          },
          "then": {
            "properties": {
              "inclusionProbability": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "populationDenominator": {
                "type": "integer",
                "minimum": 1
              },
              "synthetic": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "panel": {
                "const": "stress"
              }
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "captureId",
        "sourceId",
        "ordinal",
        "capturedAt",
        "parserVersion",
        "registryHash",
        "metadataHash",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "captureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "capturedAt": {
          "type": "string",
          "format": "utc-instant"
        },
        "parserVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "registryHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "metadataHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "sourceCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "feedUrl",
        "capturedAt",
        "status",
        "httpStatus",
        "failure",
        "countBefore",
        "countAfter",
        "invalidEntries",
        "truncatedEntries",
        "observations"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "feedUrl": {
          "type": "string",
          "maxLength": 2048,
          "format": "article-url"
        },
        "capturedAt": {
          "type": "string",
          "format": "utc-instant"
        },
        "status": {
          "enum": [
            "ok",
            "empty",
            "failed"
          ]
        },
        "httpStatus": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        },
        "failure": {
          "enum": [
            "http",
            "redirect",
            "timeout",
            "network",
            "too_large",
            "parse",
            "budget",
            null
          ]
        },
        "countBefore": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "countAfter": {
          "type": "integer",
          "minimum": 0
        },
        "invalidEntries": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "truncatedEntries": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          },
          "minItems": 0,
          "maxItems": 200,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "type": "string"
              },
              "countBefore": {
                "type": "null"
              },
              "countAfter": {
                "const": 0
              },
              "invalidEntries": {
                "type": "null"
              },
              "truncatedEntries": {
                "type": "null"
              },
              "observations": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "failure": {
                "type": "null"
              },
              "countBefore": {
                "type": "integer",
                "minimum": 0
              },
              "invalidEntries": {
                "type": "integer",
                "minimum": 0
              },
              "truncatedEntries": {
                "type": "integer",
                "minimum": 0
              },
              "httpStatus": {
                "type": "integer",
                "minimum": 200,
                "maximum": 299
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "empty"
              }
            }
          },
          "then": {
            "properties": {
              "countBefore": {
                "const": 0
              },
              "countAfter": {
                "const": 0
              },
              "observations": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "countBefore": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "shardIndex",
        "capturedAt",
        "registryHash",
        "parserVersion",
        "sources"
      ],
      "properties": {
        "version": {
          "const": "tars-news-raw/v1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "shardIndex": {
          "type": "integer",
          "minimum": 0
        },
        "capturedAt": {
          "type": "string",
          "format": "utc-instant"
        },
        "registryHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parserVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceCapture"
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "decision",
        "primarySubject",
        "eventId",
        "themeId",
        "angleId",
        "novelty"
      ],
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2048,
          "format": "article-url"
        },
        "decision": {
          "enum": [
            "accepted",
            "rejected",
            "deferred"
          ]
        },
        "primarySubject": {
          "enum": [
            "Polity",
            "Governance",
            "Economy",
            "International relations",
            "Security",
            "Sci-Tech",
            "Environment",
            "Geography",
            "History & Culture",
            null
          ]
        },
        "eventId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "themeId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "angleId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "novelty": {
          "enum": [
            "new_development",
            "distinct_analysis",
            "repeat",
            "uncertain",
            "not_applicable"
          ]
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "primaryUrl",
        "memberUrls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "primaryUrl": {
          "type": "string",
          "maxLength": 2048,
          "format": "article-url"
        },
        "memberUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048,
            "format": "article-url"
          },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyHash",
        "indexHash",
        "registryHash",
        "codeHash"
      ],
      "properties": {
        "policyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "policyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "indexHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registryHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "codeHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "articles",
        "units"
      ],
      "properties": {
        "articles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prediction"
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit"
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "clock",
        "versions",
        "observationsHash",
        "historyHash",
        "inputHash",
        "outputHash",
        "articles",
        "units"
      ],
      "properties": {
        "version": {
          "const": "tars-news-run/v1"
        },
        "clock": {
          "type": "string",
          "format": "utc-instant"
        },
        "versions": {
          "$ref": "#/$defs/versions"
        },
        "observationsHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "historyHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "articles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prediction"
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit"
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        }
      }
    }
  }
}
