{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tars.local/evaluation/editorial-output-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "clock",
    "candidates",
    "readingUnits",
    "todayUnitIds",
    "archiveUnitIds",
    "replacements"
  ],
  "properties": {
    "version": {
      "const": "tars-editorial-output/v1"
    },
    "clock": {
      "type": "string",
      "format": "utc-instant"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "state",
          "readingNeedId",
          "reasonCodes"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "article-url",
            "maxLength": 2048
          },
          "state": {
            "enum": [
              "rejected",
              "qualified_duplicate_internal",
              "qualified_unselected_internal",
              "selected_reading_unit"
            ]
          },
          "readingNeedId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              {
                "type": "null"
              }
            ]
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "uniqueItems": true
          }
        }
      },
      "uniqueItems": true
    },
    "readingUnits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "readingNeedId",
          "developmentId",
          "themeId",
          "kind",
          "representativeUrl",
          "observationIds",
          "firstSelectedAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "readingNeedId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "developmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "themeId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "development",
              "distinct_analysis"
            ]
          },
          "representativeUrl": {
            "type": "string",
            "format": "article-url",
            "maxLength": 2048
          },
          "observationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "uniqueItems": true
          },
          "firstSelectedAt": {
            "type": "string",
            "format": "utc-instant"
          },
          "updatedAt": {
            "type": "string",
            "format": "utc-instant"
          }
        }
      },
      "uniqueItems": true
    },
    "todayUnitIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "uniqueItems": true,
      "maxItems": 50
    },
    "archiveUnitIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "uniqueItems": true
    },
    "replacements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unitId",
          "readingNeedId",
          "developmentId",
          "fromUrl",
          "toUrl",
          "at",
          "reasonCodes",
          "evidence"
        ],
        "properties": {
          "unitId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "readingNeedId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "developmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "fromUrl": {
            "type": "string",
            "format": "article-url",
            "maxLength": 2048
          },
          "toUrl": {
            "type": "string",
            "format": "article-url",
            "maxLength": 2048
          },
          "at": {
            "type": "string",
            "format": "utc-instant"
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observationId",
                "field",
                "start",
                "end"
              ],
              "properties": {
                "observationId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "field": {
                  "enum": [
                    "title",
                    "description",
                    "bylines",
                    "categories"
                  ]
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "uniqueItems": true
          }
        }
      },
      "uniqueItems": true
    }
  }
}
