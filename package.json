{
  "name": "tars-clean",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TARS Atlas, News and Settings foundation",
  "scripts": {
    "dev": "vite",
    "build": "node tools/build-atlas-assets.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint src tools/news functions vite.config.ts",
    "atlas:pyq": "node tools/atlas-build/canonical-pyq.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "atlas:assets": "node tools/build-atlas-assets.mjs",
    "test:pipeline": "npm test --prefix tools/atlas-build",
    "test:cloudflare": "vitest run tools/cloudflare",
    "test:sync": "node tools/browser/sync-check.mjs",
    "news:probe": "node tools/news/probe.ts",
    "news:snapshot": "node tools/news/snapshot.ts",
    "news:audit": "node tools/news/audit.ts",
    "news:evaluation": "node tools/news/evaluation/cli.ts",
    "test:evaluation": "node --test tools/news/evaluation/evaluation.test.ts",
    "news:reader": "node tools/news/reader-probe.mjs",
    "news:relevance": "node tools/current-affairs/build-relevance.mjs",
    "test:browser": "node tools/browser/run.mjs",
    "build:cloudflare": "node tools/cloudflare/build.mjs",
    "atlas:places": "npm run places --prefix tools/atlas-build",
    "atlas:soi": "node tools/atlas-build/import-soi-boundary.mjs",
    "test:source-intelligence": "vitest run src/current-affairs/validator-v3 tools/cloudflare/current-affairs.test.ts src/features/current-affairs/useFeeds.test.tsx",
    "test:source-audit": "node --test tools/news/evaluation/source-audit.test.ts",
    "news:source-audit": "node tools/news/evaluation/source-audit-cli.ts",
    "test:bootstrap": "node --test tools/news/evaluation/bootstrap.test.ts tools/news/evaluation/editorial.test.ts",
    "news:bootstrap": "node tools/news/evaluation/bootstrap-cli.ts",
    "news:bootstrap:capture": "node tools/news/evaluation/bootstrap-capture.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "dexie": "^4.4.6",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  },
  "workspaces": [
    "tools/atlas-build",
    "tools/browser"
  ]
}
